*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Source files are LF everywhere — the verify harnesses (smoke gate) match
# source text with literal "\n" needles, and Windows autocrlf checkouts made
# those false-fail (blocked finish_and_publish twice). Pin LF so Git never
# swaps line endings on checkout again.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.sh text eol=lf

# Release metadata is rewritten by the host publisher. Keep it LF even when
# core.autocrlf=true so a completed/aborted version bump cannot leave a
# content-identical file looking dirty to the next Publish preflight.
owllm-desktop/src-tauri/Cargo.toml text eol=lf
owllm-desktop/src-tauri/Cargo.lock text eol=lf
owllm-desktop/src-tauri/tauri.conf.json text eol=lf
