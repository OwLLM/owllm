# Model artifacts and checkpoints (large/generated files)
outputs/
checkpoints/
fine_tuned/
fine_tuned_adapter/
cache/
*.ckpt
*.pt
*.pth
*.safetensors
*.bin
pytorch_model.bin

# Keep model directory structures but exclude weights
# Models should be downloaded on each machine
LLM/models/**/*.safetensors
LLM/models/**/*.bin
LLM/models/**/*.pth
LLM/models/**/*.pt
# But allow config files
!LLM/models/**/config.json
!LLM/models/**/tokenizer*.json
!LLM/models/**/*.md

# Auto-generated model status (regenerate after clone)
LLM/MODELS_README.md

# Per-run experiment artifacts and generated metadata
# W&B offline runs and logs
LLM/wandb/
wandb/
**/offline-run-*/

# Model mapping and auto-generated checkpoint folders
**/model_map.json
**/M*Checkpoint*/

# Dataset caches and large data files
data/
# ...but the website keeps page CONTENT in src/data/, which the rule above
# silently swallowed — the site could never build from a clean checkout.
# release.json stays ignored: `npm run sync:release` regenerates it per build.
!owllm-website/src/data/
owllm-website/src/data/release.json
dataset/
*.jsonl
.cache/
huggingface/
transformers_cache/

# Compiled caches
unsloth_compiled_cache/
LLM/unsloth_compiled_cache/

# Experiment tracking
wandb/
mlruns/
tensorboard/
runs/

# IDE/editor
.vscode/
.idea/

