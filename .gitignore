*.whl
*.exe
*.zip
*.7z

# Portable Go toolchain (bootstrap.exe is built from
# LLM/bootstrap/bootstrap_go). The SDK is ~70 MB extracted; we keep
# it on disk so build_installer.bat works without a system-wide Go
# install, but never commit it. Same for the Go build/module caches.
LLM/tools/go/
LLM/tools/gocache/
LLM/tools/gopath/

# Portable Rust toolchain (bootstrap.exe future-state — see
# LLM/docs/supervisor/RUST_MIGRATION.md). SDK is ~600 MB extracted.
# Same isolation-from-system principle as Go: never commit it,
# downloaded on demand via LLM/tools/download_rust.ps1.
LLM/tools/rust/

# Cargo build output for bootstrap_rs — gigabytes once full deps
# are downloaded, but trivially rebuildable from Cargo.toml + Cargo.lock.
LLM/bootstrap/bootstrap_rs/target/

# ---------------------------------------------------------------------
# Module system (see data/modules/registry.json + SCHEMA.md).
# Everything under runtime-data/ is downloaded by bootstrap.bat — never
# commit. Same for the staging area where build-release.bat assembles
# module ZIPs before upload. Drops ~25k files from the working tree.
# ---------------------------------------------------------------------
runtime-data/tools/
runtime-data/vendor/
runtime-data/.envs/
runtime-data/python_runtime/
runtime-data/runtime/
runtime-data/models/
python-app/bootstrap/bootstrap/
python-app/twinforge_loop_out/
owllm-desktop/dist/modules/
owllm-desktop/resources/runtime/llama/
owllm-desktop/resources/runtime/whisper.cpp/ggml-*.bin
# Cargo target dir for the desktop crate — gigabytes, trivially rebuildable.
owllm-desktop/src-tauri/target/
owllm-desktop/src-tauri/sync-harness/target/
owllm-desktop/.tauri-keys/
# Local runtime install (models, python runtime, envs, state). Created on the
# user's machine and resolved at runtime — never bundled from the repo. Was
# partly tracked by accident; de-tracked here.
runtime-data/
# Release-staging build output (installers + .sig) — multi-GB, rebuildable.
owllm-desktop/rel*/
# Scratch.
owllm-desktop/tooltest/

# OWLLM project-local runtime state. These files are recreated by the app and
# must not become permanent Git changes. Keep durable project metadata such as
# .owllm/project.json, .owllm/verify.json, skills, and assets trackable.
.owllm-inbox/
.owllm/brainstorm.json
.owllm/eval-traces.jsonl

# Credential / secret material — must NEVER be committed or bundled. A stray
# `git add -A` has swept a dev's runtime vault into the tree before, and it then
# shipped inside the installer. Enforced at ship time by
# credentialEmbedGuard.verify.run.mjs; ignored here so it can't be staged.
*vault*.json
*credentials.json
*credential.json
auth.json
owllm_agent_secrets.json
LLM/data/owllm_agent_secrets.json
*.pem
*.pfx
*.p12
id_rsa
id_ed25519
.env
!.env.example
!.env.sample
!.env.template
# WebView2 / Chromium browser profile (holds saved website logins + cookies).
browser_profile/
EBWebView/
Login Data

# Disk-janitor quarantine: a build cache renamed aside before deletion
# (fleet.rs QUARANTINE_PREFIX). Applies to EVERY subproject, not just
# owllm-desktop/ — see is_app_scratch.
.owllm-reclaimed-*/
