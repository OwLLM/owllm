.venv/
env/
venv/

# Notebook checkpoints
.ipynb_checkpoints/

# Experiment tracking and monitoring
wandb/
mlruns/
tensorboard/
runs/
allfiles.txt
sizes.tmp
all_objects.txt
big_files.txt
$null
