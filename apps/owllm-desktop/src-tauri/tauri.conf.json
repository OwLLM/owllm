{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwLLM Desktop",
  "version": "0.1.0",
  "identifier": "com.localllm.owllm-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default window capability",
          "windows": ["main"],
          "permissions": ["core:default", "core:event:default"]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "OwLLM Desktop",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
