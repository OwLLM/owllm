  "dataLayer": {
    "_comment": "Files pulled from raw.githubusercontent on launch with local cache fallback. Hot-reloadable without restart. NOT modules; updated by committing to main.",
    "paths": [
      "data/teams/*.json",
      "data/roles/*.yaml",
      "data/skills/*.md",
      "data/model-profiles/*.json",
      "data/mcp-recommendations/*.json",
      "data/abliteration-corpus/*.md"
    ]
  },
  "systemPrerequisites": {
    "_comment": "External installs the user must have on PATH. Not modules; the wizard checks for them and surfaces install instructions if missing.",
    "items": [
      {
        "id": "git",
        "displayName": "Git",
        "required": true,
        "reason": "Fleet worktree isolation (per-agent git worktrees) requires git on PATH.",
        "checkCommand": "git --version",
        "installHint": "https://git-scm.com/download/win"
      },
      {
        "id": "vscodium-or-cursor-or-vscode",
        "displayName": "External code editor",
        "required": false,
