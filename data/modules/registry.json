    "items": [
      {
        "id": "git",
        "displayName": "Git",
        "required": true,
        "reason": "Fleet worktree isolation (per-agent git worktrees) requires git on PATH.",
        "checkCommand": "git --version",
        "installHint": "https://git-scm.com/download/win"
      },
      {
        "id": "vscodium-or-cursor-or-vscode",
        "displayName": "External code editor",
        "required": false,
        "reason": "Code page launches your preferred editor. Detection order: VSCodium > Cursor > VS Code on PATH.",
        "checkCommand": "codium --version || cursor --version || code --version",
        "installHint": "https://vscodium.com/ or https://cursor.com/ or https://code.visualstudio.com/"
      }
    ]
  },
