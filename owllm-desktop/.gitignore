node_modules/
dist/
ui/dist/
target/
*.log
.DS_Store

# Bundled Python engine — wiped on 2026-05-14 (Rust owns the runtime).
# Kept here as a safety net in case stale local checkouts still have
# the directory; never committed.
python_engine/

# Tauri generated stubs that bloat the build cache.
src-tauri/.tauri/

# Per-run eval traces written by the in-app Run Report (Layer 2). Dev artifact;
# the node scorecard (team.eval.run.mjs) reads them, they are never committed.
.owllm/

# TwinForge working copies + per-run backups (the Coder edits a
# timestamped sibling and the run driver may leave a *_PREPATCH_*.tsx
# on disk so the user can revert by-hand after a regression).
ui/src/**/*_PATCH_*.tsx
ui/src/**/*_PREPATCH_*.tsx
ui/src/**/*_PATCH_*.css
ui/src/**/*_PREPATCH_*.css

# Tauri auto-update signing key. PRIVATE — never commit.
.tauri-keys/
