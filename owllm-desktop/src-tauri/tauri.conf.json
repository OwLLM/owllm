{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwLLM Desktop",
  "version": "0.7.70",
  "identifier": "com.localllm.owllm-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default window capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:event:default",
            "core:window:default",
            "core:window:allow-start-dragging",
            "core:window:allow-start-resize-dragging",
            "core:window:allow-minimize",
            "core:window:allow-unminimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-maximize",
            "core:window:allow-unmaximize",
            "core:window:allow-is-maximized",
            "core:window:allow-is-minimized",
            "core:window:allow-close",
            "core:window:allow-show",
            "core:window:allow-set-skip-taskbar",
            "updater:default",
            "dialog:default",
            "process:default"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "OwLLM Desktop",
        "width": 1400,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#06080d"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../resources/runtime/whisper.cpp/*",
      "../resources/agents/roles/*",
      "../resources/agents/teams/*",
      "../resources/agents/skills/**/*",
      "../resources/profiles/*",
      "../resources/configs/*",
      "../resources/tools/*",
      "../resources/core/*",
      "../resources/finetune.py"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first LLM desktop with agentic teams, MCP tools, and a Tauri-native runtime.",
    "longDescription": "OwLLM Desktop is a local-first AI workstation. It runs llama.cpp models on your hardware, orchestrates multi-agent teams, connects to MCP servers, and bridges Telegram/WhatsApp for remote control. Rust owns the runtime â€” model lifecycle, hardware probe, tool execution. React owns the UI. Cloud models (Claude / GPT / Gemini) are first-class peers when you provide keys.",
    "publisher": "OWLLM",
    "copyright": "Copyright Â© 2026 OWLLM. MIT-licensed.",
    "homepage": "https://github.com/ruigro/LLM-Studio",
    "category": "DeveloperTool",
    "licenseFile": "../../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {}
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "release": "1",
        "epoch": 0
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "windowPosition": { "x": 200, "y": 200 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "certificateThumbprint": "86D13D491414359FD09379181D4D1CC2B5E4E6AF",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://time.certum.pl",
      "tsp": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "template": "installer.nsi",
        "languages": ["English"]
      },
      "allowDowngrades": false
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://github.com/OwLLM/owllm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRkY2MTQ3NDU3NjhEREYKUldUZmpYWkZSMkgvcy9VZktYT0RDVWxoWXZjdEk0ZzNzUG93TERBek1iM2tKS3laZmtIT2g3ekkK"
    }
  }
}
