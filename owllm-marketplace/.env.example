# Marketplace web OAuth app credentials.
# Create a separate GitHub OAuth App for the marketplace; do NOT reuse the
# desktop Device Flow client ID from owllm-desktop/ui/src/pages/agentic/github.ts.
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret

# Session configuration.
# SESSION_SECRET must be at least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-min-32-characters
SESSION_MAX_AGE_MS=86400000

# Trust proxy setting for Express when behind a reverse proxy (e.g. '1', 'true').
TRUST_PROXY=

# Admin allowlist: comma-separated immutable GitHub user IDs.
ADMIN_GITHUB_IDS=12345678

# SQLite database path.
DATABASE_PATH=./data/marketplace.db

NODE_ENV=development
PORT=3000
