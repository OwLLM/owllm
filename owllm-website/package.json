{
  "name": "owllm-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run sync:release && npm run build:demo",
    "prebuild": "npm run sync:release && npm run build:demo",
    "build": "astro build && npm test",
    "build:demo": "node scripts/build-app-demo.mjs",
