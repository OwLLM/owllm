<script>
  (function () {
    const root = document.getElementById("app-mock");
    if (!root) return;

    const modules = JSON.parse(root.dataset.modules || "[]") as {
      id: string;
      firstTab: string;
      pages: string[];
    }[];

    const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>(".mode-toggle"));
    const tabButtons = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const screens = Array.from(root.querySelectorAll<HTMLElement>(".screen"));
    const captionText = document.getElementById("mock-caption-text");
    const captionTip = document.getElementById("mock-caption-tip");

    function moduleOf(pageKey: string): string {
      const m = modules.find((mod) => mod.pages.includes(pageKey));
      return m ? m.id : "home";
    }

    function show(pageKey: string) {
      const modId = moduleOf(pageKey);

      modeButtons.forEach((b) => {
        const active = b.dataset.module === modId;
        b.classList.toggle("active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });

      tabButtons.forEach((b) => {
        const inModule = b.dataset.module === modId;
        b.hidden = !inModule;
        const active = b.dataset.page === pageKey;
        b.classList.toggle("active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });

      screens.forEach((s) => {
        s.hidden = s.dataset.screen !== pageKey;
      });

      const tpl = root!.querySelector<HTMLTemplateElement>(`template[data-caption-for="${pageKey}"]`);
      if (tpl && captionText && captionTip) {
        captionText.textContent = tpl.content.textContent || "";
        captionTip.textContent = "💡 " + (tpl.dataset.tip || "");
      }
    }

    modeButtons.forEach((b) => {
      b.addEventListener("click", () => {
        const mod = modules.find((m) => m.id === b.dataset.module);
        if (mod) show(mod.firstTab);
      });
    });

    tabButtons.forEach((b) => {
      b.addEventListener("click", () => {
        if (b.dataset.page) show(b.dataset.page);
      });
    });

    // Deep-link hook for guide steps: owllmMockGo("agents") scrolls to the
    // mock and activates that page.
    (window as any).owllmMockGo = function (pageKey: string) {
      show(pageKey);
      root!.scrollIntoView({ behavior: "smooth", block: "center" });
    };

    document.querySelectorAll<HTMLElement>("[data-mock-go]").forEach((el) => {
      el.addEventListener("click", () => {
        const key = el.dataset.mockGo;
        if (key) (window as any).owllmMockGo(key);
      });
    });
  })();
</script>

