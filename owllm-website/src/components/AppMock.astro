---
/*
 * Interactive, clickable mock of the OWLLM desktop app.
 *
 * The module / tab structure mirrors owllm-desktop/ui/src/core/modules.ts
 * (values copied so this package stays standalone):
 *   Home:         home, server, info
 *   Fine Tuning:  models, dataset, train, chat        (first tab: models)
 *   Agentic Team: code, agents, studio, assets, bridges (first tab: agents)
 *   Gamify:       gamify, characters, world-map        (first tab: gamify)
 *   Advanced:     mcp, accounts, devices               (first tab: mcp)
 *
 * Pure Astro + vanilla JS on purpose — the site's only React island is the
 * theme toggle. Exposes window.owllmMockGo(pageKey) so guide steps can
 * deep-link into a specific mock screen.
 */

interface MockPage {
  key: string;
  label: string;
  caption: string;
  tip: string;
}

interface MockModule {
  id: string;
  toggle: string;
  firstTab: string;
  pages: MockPage[];
}

const MODULES: MockModule[] = [
  {
    id: "home",
    toggle: "🏠 Home",
    firstTab: "home",
    pages: [
      {
        key: "home",
        label: "🏠 Home",
        caption:
          "The launchpad. OWLLM probes your hardware (GPU, VRAM, RAM) on startup and shows what your machine can run — every module you installed is one click away.",
        tip: "Try the mode toggles in the header: Fine Tuning, Agentic Team, Gamify, Advanced.",
      },
      {
        key: "server",
        label: "🖧 Server",
        caption:
          "The local model server (llama.cpp). You almost never touch it: the server auto-starts on your first message and is shared across every OWLLM window.",
        tip: "In the real app this opens as a status modal — start, stop, and port adoption live here.",
      },
      {
        key: "info",
        label: "ℹ️ Info",
        caption:
          "Version, update channel, and diagnostics. Updates ship signed, with a plain-language changelog.",
        tip: "Click 🛠 Fine Tuning in the header to move to the model workshop.",
      },
    ],
  },
  {
    id: "finetuning",
    toggle: "🛠 Fine Tuning",
    firstTab: "models",
    pages: [
      {
        key: "models",
        label: "📦 Models",
        caption:
          "Search HuggingFace or pick a curated recommendation. Every model is color-coded by whether it fits your VRAM, and interrupted downloads resume where they left off.",
        tip: "Green = fits fully on GPU, amber = tight, red = won't fit. The Tuned tab holds your own fine-tuned models.",
      },
      {
        key: "dataset",
        label: "📚 Dataset",
        caption:
          "The Dataset Builder turns your documents — PDF, DOCX, URLs — into instruction/output training pairs, ready for fine-tuning. No JSONL hand-editing.",
        tip: "Feed it a product manual and you get a training set for a support model.",
      },
      {
        key: "train",
        label: "🎯 Train",
        caption:
          "Fine-tune with LoRA on your own GPU. Pick the base model, drop in the dataset, watch the loss curve live. The Python environment installs itself on demand — only Train needs it.",
        tip: "Finished adapters can be exported to GGUF and served locally like any other model.",
      },
      {
        key: "chat",
        label: "💬 Chat",
        caption:
          "Talk to any model — local GGUF, cloud API, or your freshly fine-tuned adapter. Nothing auto-picks a model: the picker reads “Select model” until YOU choose.",
        tip: "Vision models work too — OWLLM auto-downloads the matching projector.",
      },
    ],
  },
  {
    id: "agentic",
    toggle: "🎭 Agentic Team",
    firstTab: "agents",
    pages: [
      {
        key: "code",
        label: "💻 Coding",
        caption:
          "A solo coder working directly in a project folder — conversation, plan, and model persist per project. Tool execution runs inside a real Linux sandbox (WSL2 / Lima / bubblewrap).",
        tip: "“Done” is a real command's exit code, never the model's say-so — that's the Verification Gate.",
      },
      {
        key: "agents",
        label: "🤖 Agents",
        caption:
          "The flagship. One standard team: an orchestrator plans, a scout researches, two workers execute in parallel, a critic reviews, and a producer publishes only approved work. The arrows are a real execution graph.",
        tip: "Type while a run is going — your message queues as a ⚡ steer and is injected at the next agent boundary. Never dropped.",
      },
      {
        key: "studio",
        label: "🎭 Studio",
        caption:
          "Brainstorm canvas and custom team builder. Sketch ideas with your agents, then promote the good ones into real runs.",
        tip: "The 10-agent hierarchical Product Studio (design sub-team → whitepaper → parallel FE/BE lanes) lives here.",
      },
      {
        key: "assets",
        label: "🖼 Assets",
        caption: "Everything your teams produce — images, documents, artifacts — collected per project.",
        tip: "Agents can generate screenshots of the pages they build; they land here.",
      },
      {
        key: "bridges",
        label: "📱 Bridges",
        caption:
          "Drive your agent teams from messaging apps. A bridge relays a chat (WhatsApp, Telegram, …) straight into a team run and streams the result back.",
        tip: "Message your own computer from your phone and it codes for you.",
      },
    ],
  },
  {
    id: "gamify",
    toggle: "🎮 Gamify",
    firstTab: "gamify",
    pages: [
      {
        key: "gamify",
        label: "🎮 Gamify",
        caption:
          "An experimental RPG layer driven by the same dispatch stream as your real runs — your agents' work earns progress in a living world.",
        tip: "Every real tool call your team makes moves the world forward.",
      },
      {
        key: "characters",
        label: "🧙 Characters",
        caption: "Your agents as characters — roles, levels, and history built from actual runs.",
        tip: "The critic makes an excellent grumpy wizard.",
      },
      {
        key: "world-map",
        label: "🌐 World Map",
        caption:
          "A Solar System explorer around the live presence globe — all 8 planets with NASA-derived textures, focus and zoom flights.",
        tip: "The globe shows live, anonymous OWLLM presence around the world.",
      },
    ],
  },
  {
    id: "advanced",
    toggle: "⚙ Advanced",
    firstTab: "mcp",
    pages: [
      {
        key: "mcp",
        label: "🧩 MCP",
        caption:
          "Connect Model Context Protocol servers to give agents new tools. Master switch, per-tool toggles, and a schema-safety gate — servers auto-start when a team needs them.",
        tip: "Team profiles can require an MCP pack and it's wired automatically.",
      },
      {
        key: "accounts",
        label: "🔐 Accounts",
        caption:
          "API keys for cloud models (Anthropic, OpenAI, Gemini, …) and subscription CLI logins (Claude Code, Codex, Gemini). Keys live in your local vault — never in builds or repos.",
        tip: "Mix local and cloud models freely in one team once a key is added.",
      },
      {
        key: "devices",
        label: "🖥 Devices",
        caption:
          "Pair your other machines over an end-to-end encrypted channel: run commands, see screens, and build a personal fleet — no SSH setup.",
        tip: "A paired gaming PC can serve models to your laptop.",
      },
    ],
  },
];

const ALL_PAGES = MODULES.flatMap((m) => m.pages.map((p) => ({ ...p, module: m.id })));
const mockData = JSON.stringify(
  MODULES.map((m) => ({
    id: m.id,
    firstTab: m.firstTab,
    pages: m.pages.map((p) => p.key),
  })),
);
---

<div class="appmock" id="app-mock" data-modules={mockData}>
  <p class="mock-badge" aria-hidden="true">▶ LIVE MOCK — click around, nothing can break</p>

  <div class="frame" role="application" aria-label="Interactive mock of the OWLLM app">
    <!-- Title bar: mode toggles, like the app's header chrome (dark in both themes). -->
    <div class="titlebar">
      <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="app-brand">🦉 OWLLM</span>
      <div class="mode-toggles" role="tablist" aria-label="App modules">
        {
          MODULES.map((m) => (
            <button
              type="button"
              class={`mode-toggle${m.id === "home" ? " active" : ""}`}
              role="tab"
              aria-selected={m.id === "home" ? "true" : "false"}
              data-module={m.id}
            >
              {m.toggle}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Tab strip of the active module. -->
    <div class="tabstrip" role="tablist" aria-label="Pages of the active module">
      {
        ALL_PAGES.map((p) => (
          <button
            type="button"
            class={`tab${p.key === "home" ? " active" : ""}`}
            role="tab"
            aria-selected={p.key === "home" ? "true" : "false"}
            data-page={p.key}
            data-module={p.module}
            hidden={p.module !== "home"}
          >
            {p.label}
          </button>
        ))
      }
    </div>

    <!-- Screens. One per page; toggled by the script. -->
    <div class="screen-area">
      <!-- 🏠 Home -->
      <div class="screen" data-screen="home" role="tabpanel">
        <div class="mk-grid mk-grid-3">
          <div class="mk-card">
            <div class="mk-kicker">HARDWARE</div>
            <div class="mk-big">RTX 4090</div>
            <div class="mk-sub">24 GB VRAM · CUDA</div>
            <div class="mk-bar"><span style="width: 62%"></span></div>
            <div class="mk-sub">14.9 / 24 GB in use</div>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">LOCAL SERVER</div>
            <div class="mk-big"><span class="mk-dot ok"></span> Running</div>
            <div class="mk-sub">llama-server · port 8080</div>
            <div class="mk-tag">Qwen2.5-Coder-14B · Q4_K_M</div>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">QUICK START</div>
            <div class="mk-btnrow">
              <span class="mk-btn primary">💬 New chat</span>
              <span class="mk-btn">🤖 New team run</span>
            </div>
            <div class="mk-btnrow">
              <span class="mk-btn">📦 Get a model</span>
              <span class="mk-btn">🎯 Fine-tune</span>
            </div>
          </div>
        </div>
        <div class="mk-card mk-wide">
          <div class="mk-kicker">RECENT PROJECTS</div>
          <div class="mk-row"><span class="mk-dot ok"></span> owllm-website <span class="mk-faint">· team run finished 12 min ago · ✔ verify passed</span></div>
          <div class="mk-row"><span class="mk-dot warn"></span> invoice-parser <span class="mk-faint">· training epoch 2/3</span></div>
          <div class="mk-row"><span class="mk-dot idle"></span> support-bot <span class="mk-faint">· idle</span></div>
        </div>
      </div>

      <!-- 🖧 Server -->
      <div class="screen" data-screen="server" role="tabpanel" hidden>
        <div class="mk-card mk-wide">
          <div class="mk-rowline">
            <span class="mk-big"><span class="mk-dot ok"></span> llama-server</span>
            <span class="mk-btnrow"><span class="mk-btn">⏹ Stop</span><span class="mk-btn primary">↻ Restart</span></span>
          </div>
          <div class="mk-row mk-faint">--jinja · port 8080 · context 8192 · shared across all OWLLM windows</div>
        </div>
        <div class="mk-grid mk-grid-3">
          <div class="mk-card"><div class="mk-kicker">MODEL</div><div class="mk-row">Qwen2.5-Coder-14B</div><div class="mk-tag">Q4_K_M · 8.9 GB</div></div>
          <div class="mk-card"><div class="mk-kicker">THROUGHPUT</div><div class="mk-big">93 tok/s</div><div class="mk-sub">generation · GPU offload 100%</div></div>
          <div class="mk-card"><div class="mk-kicker">VISION</div><div class="mk-row"><span class="mk-dot ok"></span> mmproj loaded</div><div class="mk-sub">projector auto-downloaded</div></div>
        </div>
        <div class="mk-log">
          <div>srv  log: request: POST /v1/chat/completions 200</div>
          <div>srv  log: 41 tokens prompt, 512 predicted, 93.2 t/s</div>
          <div>srv  log: slot released, kv cache 38%</div>
        </div>
      </div>

      <!-- ℹ️ Info -->
      <div class="screen" data-screen="info" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-2">
          <div class="mk-card">
            <div class="mk-kicker">ABOUT</div>
            <div class="mk-big">OWLLM</div>
            <div class="mk-sub">Orchestrated Workflow for LLM</div>
            <div class="mk-row">Version <span class="mk-tag">1.0.6</span> <span class="mk-dot ok"></span> <span class="mk-faint">up to date</span></div>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">MODULES INSTALLED</div>
            <div class="mk-row">✅ Core · ✅ Fine-tuning · ✅ Agentic</div>
            <div class="mk-row">✅ Advanced · ⬜ Gamify</div>
            <div class="mk-sub">add or remove any time — installs on demand</div>
          </div>
        </div>
        <div class="mk-card mk-wide">
          <div class="mk-kicker">LATEST UPDATE</div>
          <div class="mk-row">v1.0.6 — Linux gets the app-styled browser chrome bar; address bar no longer shows internal URLs.</div>
          <div class="mk-sub">updates are signed and describe themselves in plain language</div>
        </div>
      </div>

      <!-- 📦 Models -->
      <div class="screen" data-screen="models" role="tabpanel" hidden>
        <div class="mk-searchrow">
          <span class="mk-input">🔍 Search HuggingFace… <span class="mk-caret"></span></span>
          <span class="mk-btn">Curated picks</span>
          <span class="mk-btn">Tuned</span>
        </div>
        <div class="mk-grid mk-grid-3">
          <div class="mk-card fit-ok">
            <div class="mk-row"><strong>Qwen2.5-Coder-14B</strong></div>
            <div class="mk-tag ok-tag">fits your 24 GB GPU</div>
            <div class="mk-sub">Q4_K_M · 8.9 GB · ⭐ recommended for coding</div>
            <span class="mk-btn primary">⬇ Download</span>
          </div>
          <div class="mk-card fit-warn">
            <div class="mk-row"><strong>Llama-3.3-70B</strong></div>
            <div class="mk-tag warn-tag">tight — needs 21+ GB</div>
            <div class="mk-sub">Q2_K · 21.1 GB · quality tradeoff at this quant</div>
            <span class="mk-btn">⬇ Download</span>
          </div>
          <div class="mk-card">
            <div class="mk-row"><strong>Gemma-3-27B (vision)</strong></div>
            <div class="mk-bar"><span style="width: 71%"></span></div>
            <div class="mk-sub">⏬ resuming download · 11.2 / 15.8 GB</div>
            <span class="mk-btn">⏸ Pause</span>
          </div>
        </div>
        <div class="mk-sub mk-center">VRAM-fit color coding · interrupted downloads resume via HTTP Range — no restart from 0%</div>
      </div>

      <!-- 📚 Dataset -->
      <div class="screen" data-screen="dataset" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-2">
          <div class="mk-card">
            <div class="mk-kicker">SOURCES</div>
            <div class="mk-row">📄 product-manual.pdf <span class="mk-tag">parsed · 214 chunks</span></div>
            <div class="mk-row">📄 faq.docx <span class="mk-tag">parsed · 58 chunks</span></div>
            <div class="mk-row">🔗 docs.example.com <span class="mk-tag ok-tag">crawled · 31 pages</span></div>
            <span class="mk-btn">＋ Add source</span>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">GENERATED PAIRS — 1,847</div>
            <div class="mk-pair">
              <div class="mk-row"><strong>instruction:</strong> How do I reset the device to factory settings?</div>
              <div class="mk-row mk-faint"><strong>output:</strong> Hold the power button for 10 seconds while…</div>
            </div>
            <div class="mk-btnrow"><span class="mk-btn">👁 Review pairs</span><span class="mk-btn primary">💾 Export JSONL</span></div>
          </div>
        </div>
        <div class="mk-sub mk-center">documents in → instruction/output training pairs out — ready for the Train tab</div>
      </div>

      <!-- 🎯 Train -->
      <div class="screen" data-screen="train" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-3">
          <div class="mk-card">
            <div class="mk-kicker">RECIPE</div>
            <div class="mk-row">Base: <span class="mk-tag">Qwen2.5-7B (bnb-4bit)</span></div>
            <div class="mk-row">Data: <span class="mk-tag">support-set.jsonl · 1,847</span></div>
            <div class="mk-row">LoRA r=16 · lr 2e-4 · 3 epochs</div>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">PROGRESS</div>
            <div class="mk-big">Epoch 2/3</div>
            <div class="mk-bar"><span style="width: 58%"></span></div>
            <div class="mk-sub">loss 0.84 ↓ · 41 min left · GPU 96%</div>
          </div>
          <div class="mk-card">
            <div class="mk-kicker">AFTER TRAINING</div>
            <div class="mk-row">📦 Export GGUF</div>
            <div class="mk-row">💬 Chat with adapter</div>
            <div class="mk-row">🖧 Serve locally</div>
          </div>
        </div>
        <div class="mk-log">
          <div>step 1240/2130 · loss 0.842 · lr 1.6e-4</div>
          <div>step 1250/2130 · loss 0.831 · lr 1.6e-4</div>
          <div>checkpoint saved · adapters/support-bot/ckpt-1250</div>
        </div>
      </div>

      <!-- 💬 Chat -->
      <div class="screen" data-screen="chat" role="tabpanel" hidden>
        <div class="mk-chatarea">
          <div class="mk-bubble user">Summarize what changed in our returns policy PDF.</div>
          <div class="mk-bubble bot">Three changes: the return window grew from 14 to 30 days, opened software is now non-refundable, and store credit refunds process instantly instead of in 3–5 days.</div>
          <div class="mk-bubble user">Draft the announcement email.</div>
          <div class="mk-bubble bot typing"><span></span><span></span><span></span></div>
        </div>
        <div class="mk-composer">
          <span class="mk-modelpick">📦 support-bot-lora · local</span>
          <span class="mk-input grow">Type a message… <span class="mk-caret"></span></span>
          <span class="mk-btn primary">Send ➤</span>
        </div>
        <div class="mk-sub mk-center">the server started itself on first send — no setup step</div>
      </div>

      <!-- 💻 Coding -->
      <div class="screen" data-screen="code" role="tabpanel" hidden>
        <div class="mk-codegrid">
          <div class="mk-card mk-filetree">
            <div class="mk-kicker">PROJECT</div>
            <div class="mk-row">📁 src/</div>
            <div class="mk-row mk-indent">📄 app.ts <span class="mk-tag">M</span></div>
            <div class="mk-row mk-indent">📄 routes.ts</div>
            <div class="mk-row">📄 package.json</div>
            <div class="mk-sub">🔒 sandboxed · WSL2</div>
          </div>
          <div class="mk-card mk-editor">
            <div class="mk-codeline"><span class="mk-ln">41</span><span class="kw">export function</span> parseInvoice(pdf: <span class="ty">Buffer</span>) {'{'}</div>
            <div class="mk-codeline added"><span class="mk-ln">42</span>  <span class="kw">const</span> pages = extractPages(pdf);</div>
            <div class="mk-codeline added"><span class="mk-ln">43</span>  <span class="kw">return</span> pages.map(readLineItems);</div>
            <div class="mk-codeline"><span class="mk-ln">44</span>{'}'}</div>
          </div>
        </div>
        <div class="mk-card mk-wide">
          <div class="mk-rowline">
            <span><span class="mk-dot ok"></span> Verification Gate: <strong>npm test</strong> → exit 0 · 34 passing</span>
            <span class="mk-tag ok-tag">✔ done means proven</span>
          </div>
        </div>
      </div>

      <!-- 🤖 Agents -->
      <div class="screen" data-screen="agents" role="tabpanel" hidden>
        <div class="mk-goal"><span class="mk-kicker">GOAL</span> Build a landing page for the bakery, deploy preview, verify build passes.</div>
        <div class="mk-teamgraph">
          <div class="mk-agent lead"><span class="mk-dot ok"></span> 🧠 Orchestrator<br /><span class="mk-faint">planning · read-only</span></div>
          <div class="mk-arrows" aria-hidden="true">▼&nbsp;&nbsp;&nbsp;▼&nbsp;&nbsp;&nbsp;▼</div>
          <div class="mk-agentrow">
            <div class="mk-agent"><span class="mk-dot ok"></span> 🔎 Scout<br /><span class="mk-faint">recon · parallel</span></div>
            <div class="mk-agent busy"><span class="mk-dot warn"></span> 🛠 Worker A<br /><span class="mk-faint">building hero section…</span></div>
            <div class="mk-agent busy"><span class="mk-dot warn"></span> 🛠 Worker B<br /><span class="mk-faint">wiring contact form…</span></div>
          </div>
          <div class="mk-arrows" aria-hidden="true">▼</div>
          <div class="mk-agentrow">
            <div class="mk-agent"><span class="mk-dot idle"></span> 🧐 Critic<br /><span class="mk-faint">advisory · ON</span></div>
            <div class="mk-agent"><span class="mk-dot idle"></span> 📦 Producer<br /><span class="mk-faint">publishes approved work only</span></div>
          </div>
        </div>
        <div class="mk-composer">
          <span class="mk-input grow">⚡ Steer the run: “use the logo from /assets”… <span class="mk-caret"></span></span>
          <span class="mk-btn">Queue steer</span>
        </div>
      </div>

      <!-- 🎭 Studio -->
      <div class="screen" data-screen="studio" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-3">
          <div class="mk-card"><div class="mk-kicker">IDEA</div><div class="mk-row">“Recipe app that plans a week of meals from what's in the fridge”</div><span class="mk-tag">brainstorm</span></div>
          <div class="mk-card"><div class="mk-kicker">IDEA</div><div class="mk-row">“Same, but it writes the shopping list to my phone via a bridge”</div><span class="mk-tag ok-tag">promoted → run</span></div>
          <div class="mk-card"><div class="mk-kicker">CUSTOM TEAM</div><div class="mk-row">🎨 Designer → 🧠 PO → 🛠×2</div><span class="mk-btn primary">▶ Launch team</span></div>
        </div>
        <div class="mk-sub mk-center">sketch with your agents, promote the winners into real runs — the Product Studio's 10-agent hierarchy lives here</div>
      </div>

      <!-- 🖼 Assets -->
      <div class="screen" data-screen="assets" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-3">
          <div class="mk-card mk-asset"><div class="mk-thumb">🖼</div><div class="mk-sub">hero-mockup.png</div></div>
          <div class="mk-card mk-asset"><div class="mk-thumb">📸</div><div class="mk-sub">preview-screenshot.png</div></div>
          <div class="mk-card mk-asset"><div class="mk-thumb">📄</div><div class="mk-sub">whitepaper.json</div></div>
        </div>
        <div class="mk-sub mk-center">everything your teams produce, collected per project</div>
      </div>

      <!-- 📱 Bridges -->
      <div class="screen" data-screen="bridges" role="tabpanel" hidden>
        <div class="mk-grid mk-grid-2">
          <div class="mk-card">
            <div class="mk-rowline"><span>💬 WhatsApp bridge</span><span class="mk-tag ok-tag">● connected</span></div>
            <div class="mk-bubble user small">“fix the failing test in invoice-parser”</div>
            <div class="mk-bubble bot small">On it — Worker A is running the suite. I'll report back here.</div>
          </div>
          <div class="mk-card">
            <div class="mk-rowline"><span>✈️ Telegram bridge</span><span class="mk-tag">○ paired · idle</span></div>
            <div class="mk-sub">messages route into team runs; results stream back to the chat</div>
            <span class="mk-btn">＋ Add bridge</span>
          </div>
        </div>
        <div class="mk-sub mk-center">your phone becomes a remote control for your agent teams</div>
      </div>

      <!-- 🎮 Gamify -->
