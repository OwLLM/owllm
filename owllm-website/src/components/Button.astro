---
export interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  type?: "button" | "submit" | "reset";
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  class: className = "",
  ariaLabel,
} = Astro.props;

const baseClasses = "button";
const variantClass = `variant-${variant}`;
const sizeClass = `size-${size}`;
const combined = [baseClasses, variantClass, sizeClass, className]
  .filter(Boolean)
  .join(" ");
---

{
  href ? (
    <a href={href} class={combined} aria-label={ariaLabel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combined} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: none;
    border-radius: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .button:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .size-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }

  .size-md {
    padding: 0.625rem 1.125rem;
    font-size: 1rem;
  }

  .size-lg {
    padding: 0.875rem 1.5rem;
    font-size: 1.125rem;
  }

  .variant-primary {
    background-color: var(--accent);
    color: var(--accent-fg);
    box-shadow: var(--shadow-sm);
  }

  .variant-primary:hover {
    box-shadow: 0 0 20px var(--accent-glow-soft);
  }

  .variant-ghost {
    background-color: var(--ghost-bg);
    color: var(--ghost-fg);
  }

  .variant-ghost:hover {
    background-color: var(--ghost-hover-bg);
    color: var(--ghost-hover-fg);
  }

  .variant-outline {
    background-color: transparent;
    color: var(--accent-ink);
    border: 1px solid var(--border-accent);
  }

  .variant-outline:hover {
    background-color: var(--accent-soft);
  }
</style>
