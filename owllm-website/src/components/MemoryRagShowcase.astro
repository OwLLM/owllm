---
// This is a mechanism visual, not a mock app screen. Its language and stages
// mirror the shipping Team Memory, retrieval, context-pack, and Curator code.
const scenarios = [
  {
    id: "browser",
    label: "Web project",
    task: "Fix the responsive preview, run the release gate, and preserve the browser-beside-app layout.",
    facts: [
      { rank: "01", type: "decision", text: "Web projects open the shared browser beside OWLLM." },
      {
        rank: "02",
        type: "rule",
        text: "Verify the production artifact—not only the development page.",
      },
      {
        rank: "03",
        type: "worklog",
        text: "Responsive checks use phone and desktop browser profiles.",
      },
    ],
  },
  {
    id: "verify",
    label: "Agent run",
    task: "Finish the implementation, route it through critique, and publish only grounded work.",
    facts: [
      {
        rank: "01",
        type: "rule",
        text: "A real command exit code—not model confidence—decides completion.",
      },
      {
        rank: "02",
        type: "decision",
        text: "Critical Thinker reviews before the rule-based Producer delivers.",
      },
      {
        rank: "03",
        type: "worklog",
        text: "Stopped or failed work pauses the next Notebook card.",
      },
    ],
  },
  {
    id: "docs",
    label: "Documents",
    task: "Extract the source documents, keep citations attached, and prepare an editable deliverable.",
    facts: [
      {
        rank: "01",
        type: "skill",
        text: "Load only the relevant PDF, DOCX, XLSX, or PPTX skill pack.",
      },
      {
        rank: "02",
        type: "rule",
        text: "Keep source evidence attached to claims and surface extraction failures.",
      },
      {
        rank: "03",
        type: "decision",
        text: "Credentials and authenticated browser state remain device-local.",
      },
    ],
  },
];

const graphNodes = [
  { label: "browser beside app", type: "decision", x: 12, y: 23, tags: "browser" },
  { label: "desktop + phone", type: "worklog", x: 27, y: 11, tags: "browser" },
  { label: "release gate", type: "rule", x: 33, y: 35, tags: "browser verify" },
  { label: "real exit code", type: "rule", x: 68, y: 16, tags: "verify" },
  { label: "Critical Thinker", type: "decision", x: 84, y: 29, tags: "verify" },
  { label: "Producer", type: "worklog", x: 74, y: 47, tags: "verify" },
  { label: "paused on failure", type: "worklog", x: 89, y: 65, tags: "verify" },
  { label: "PDF · DOCX", type: "skill", x: 65, y: 78, tags: "docs" },
  { label: "evidence + citations", type: "rule", x: 45, y: 87, tags: "docs" },
  { label: "device-local auth", type: "decision", x: 22, y: 76, tags: "docs browser" },
  { label: "Auto Skills", type: "skill", x: 9, y: 58, tags: "docs" },
  { label: "model per role", type: "decision", x: 50, y: 8, tags: "" },
  { label: "curator ≤ 2", type: "hub", x: 48, y: 62, tags: "browser verify docs" },
];

const graphEdges = [
  [12, 23, 50, 48, "browser"],
  [27, 11, 50, 48, "browser"],
  [33, 35, 50, 48, "browser verify"],
  [68, 16, 50, 48, "verify"],
  [84, 29, 50, 48, "verify"],
  [74, 47, 50, 48, "verify"],
  [89, 65, 50, 48, "verify"],
  [65, 78, 50, 48, "docs"],
  [45, 87, 50, 48, "docs"],
  [22, 76, 50, 48, "docs browser"],
  [9, 58, 50, 48, "docs"],
  [50, 8, 50, 48, ""],
  [48, 62, 50, 48, "browser verify docs"],
] as const;
---

<section class="memory-rag" id="memory-rag" data-memory-rag aria-labelledby="memory-rag-title">
  <div class="rag-field" aria-hidden="true"></div>
  <div class="container">
    <header class="rag-heading">
      <div>
        <p class="eyebrow">Memory Curator · scoped RAG · 3D knowledge graph</p>
        <h2 id="memory-rag-title">
          The right memory enters.<br /><span>The noise stays out.</span>
        </h2>
      </div>
      <p>
        Every run starts with relevance-ranked project evidence—not a dump of old chats. Watch OWLLM
        scope the task, light the matching graph, assemble the fenced context pack, and send only
        durable new knowledge back to Team Memory.
      </p>
    </header>

    <div class="rag-shell" data-rag-shell data-scenario="browser">
      <div class="rag-chrome">
        <div class="rag-title">
          <span class="brain" aria-hidden="true">🧠</span>
          <span
            ><strong>Team Memory</strong><small>shared knowledge your agents read &amp; write</small
            ></span
          >
        </div>
        <div class="rag-status" aria-live="polite">
          <span aria-hidden="true"></span> Retrieving 3 matches
        </div>
        <div class="rag-view" aria-hidden="true"><span>☰ List</span><strong>🌐 Graph</strong></div>
      </div>

      <div class="scenario-bar" aria-label="Choose an example retrieval">
        <span>Try a task</span>
        <div class="scenario-buttons">
          {
            scenarios.map((scenario, index) => (
              <button
                type="button"
                data-rag-query={scenario.id}
                data-rag-task={scenario.task}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span aria-hidden="true">0{index + 1}</span> {scenario.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="rag-workspace">
        <div class="graph-panel" aria-label="Animated Team Memory graph">
          <div class="panel-label">
            <span>PROJECT GRAPH</span><small>facts · worklog · same key</small>
          </div>
          <svg
            class="graph-edges"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            {
              graphEdges.map((edge) => (
                <line
                  x1={edge[0]}
                  y1={edge[1]}
                  x2={edge[2]}
                  y2={edge[3]}
                  data-rag-edge={edge[4]}
                  vector-effect="non-scaling-stroke"
                />
              ))
            }
          </svg>
          <div class="query-node" aria-hidden="true">
            <span>RAG</span><small>current task</small>
          </div>
          {
            graphNodes.map((node, index) => (
              <div
                class={`memory-node memory-node--${node.type}`}
                style={`--node-x:${node.x}%;--node-y:${node.y}%;--node-delay:${index * 70}ms`}
                data-rag-node={node.tags}
                aria-hidden="true"
              >
                <>
                  <i />
                  <span>{node.label}</span>
                </>
              </div>
            ))
          }
          <div class="graph-legend" aria-hidden="true">
            <span><i class="fact"></i> durable fact</span><span
              ><i class="worklog"></i> worklog</span
            ><span><i class="skill"></i> skill</span>
          </div>
        </div>

        <div class="pack-panel">
          <div class="panel-label">
            <span>INJECTED CONTEXT</span><small>bounded · labeled · fenced</small>
          </div>
          <div class="pack-task">
            <span>CURRENT TASK</span>
            <p data-rag-current-task>{scenarios[0].task}</p>
          </div>
          {
            scenarios.map((scenario, scenarioIndex) => (
              <div class="context-pack" data-rag-pack={scenario.id} hidden={scenarioIndex !== 0}>
                <div class="pack-header">
                  <span>MEMORY CURATOR CONTEXT PACK</span>
                  <small>Use as evidence / reference</small>
                </div>
                <div class="pack-rows">
                  {scenario.facts.map((fact, index) => (
                    <div class="pack-row" style={`--row-delay:${index * 150}ms`}>
                      <span class="rank">{fact.rank}</span>
                      <div>
                        <small>{fact.type}</small>
                        <p>{fact.text}</p>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="pack-task-fence">--- YOUR TASK ---</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="rag-pipeline" aria-label="Memory retrieval and curation lifecycle">
        <div class="pipeline-stage is-live">
          <span>01</span><p><strong>Scope</strong><small>project + goal</small></p>
        </div>
        <i aria-hidden="true"><b></b></i>
        <div class="pipeline-stage">
          <span>02</span><p><strong>Rank</strong><small>relevance first</small></p>
        </div>
        <i aria-hidden="true"><b></b></i>
        <div class="pipeline-stage">
          <span>03</span><p><strong>Pack</strong><small>fenced context</small></p>
        </div>
        <i aria-hidden="true"><b></b></i>
        <div class="pipeline-stage">
          <span>04</span><p><strong>Run + verify</strong><small>real evidence</small></p>
        </div>
        <i aria-hidden="true"><b></b></i>
        <div class="pipeline-stage pipeline-stage--curator">
          <span>05</span><p><strong>Curate</strong><small>save ≤ 2 facts</small></p>
        </div>
      </div>
    </div>

    <div class="rag-proof">
      <p>
        <span aria-hidden="true">↳</span> The Curator is bounded, post-run, and fire-and-forget: delivery
        never waits for memory extraction.
      </p>
      <a href="/features#memory"
        >See Team Memory in the feature map <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<script>
  function initMemoryRag(root: HTMLElement) {
    const shell = root.querySelector<HTMLElement>("[data-rag-shell]");
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-rag-query]"));
    const nodes = Array.from(root.querySelectorAll<HTMLElement>("[data-rag-node]"));
    const edges = Array.from(root.querySelectorAll<SVGElement>("[data-rag-edge]"));
    const packs = Array.from(root.querySelectorAll<HTMLElement>("[data-rag-pack]"));
    const task = root.querySelector<HTMLElement>("[data-rag-current-task]");
    const status = root.querySelector<HTMLElement>(".rag-status");
    const stages = Array.from(root.querySelectorAll<HTMLElement>(".pipeline-stage"));
    if (!shell || buttons.length === 0) return;

    let selected = 0;
    let userPausedUntil = 0;
    let stageTimers: number[] = [];

    const select = (index: number, userInitiated = false) => {
      selected = (index + buttons.length) % buttons.length;
      const button = buttons[selected];
      const id = button?.dataset.ragQuery || "browser";
      if (userInitiated) userPausedUntil = Date.now() + 14000;

      shell.dataset.scenario = id;
      shell.classList.remove("is-retrieving");
      void shell.offsetWidth;
      shell.classList.add("is-retrieving");
      buttons.forEach((item, itemIndex) =>
        item.setAttribute("aria-pressed", String(itemIndex === selected)),
      );
      nodes.forEach((node) =>
        node.classList.toggle("is-match", (node.dataset.ragNode || "").split(" ").includes(id)),
      );
      edges.forEach((edge) =>
        edge.classList.toggle("is-match", (edge.dataset.ragEdge || "").split(" ").includes(id)),
      );
      packs.forEach((pack) => {
        pack.hidden = pack.dataset.ragPack !== id;
      });
      if (task) task.textContent = button?.dataset.ragTask || "";
      if (status) status.lastChild!.textContent = " Retrieving 3 matches";

      stageTimers.forEach(window.clearTimeout);
      stageTimers = [];
      stages.forEach((stage, stageIndex) => {
        stage.classList.toggle("is-live", stageIndex === 0);
        stageTimers.push(
          window.setTimeout(() => stage.classList.add("is-live"), 480 + stageIndex * 520),
        );
      });
      if (status)
        stageTimers.push(
          window.setTimeout(() => {
            status.lastChild!.textContent = " Context ready · 3 matches";
          }, 2400),
        );
    };

    buttons.forEach((button, index) => button.addEventListener("click", () => select(index, true)));
    select(0);

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.setInterval(() => {
        if (
          document.hidden ||
          Date.now() < userPausedUntil ||
          root.matches(":hover") ||
          root.contains(document.activeElement)
        )
          return;
        select(selected + 1);
      }, 6500);
    }
  }

  document.querySelectorAll<HTMLElement>("[data-memory-rag]").forEach(initMemoryRag);
</script>

<style>
  .memory-rag {
    position: relative;
    scroll-margin-top: 5rem;
    overflow: hidden;
    padding: clamp(5rem, 9vw, 8rem) 0;
    color: #e6e8eb;
    background: #06080d;
    border-block: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container {
    width: min(1220px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .rag-field {
    position: absolute;
    inset: 0;
    opacity: 0.34;
    background:
      radial-gradient(circle at 15% 16%, rgba(var(--accent-rgb), 0.28), transparent 25%),
      radial-gradient(circle at 85% 78%, rgba(176, 124, 255, 0.18), transparent 28%),
      linear-gradient(rgba(var(--accent-rgb), 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--accent-rgb), 0.055) 1px, transparent 1px);
    background-size:
      auto,
      auto,
      32px 32px,
      32px 32px;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    pointer-events: none;
  }

  .rag-heading {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.64fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .rag-heading .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rag-heading h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }
  .rag-heading h2 span {
    color: var(--accent);
    text-shadow: 0 0 28px rgba(var(--accent-rgb), 0.26);
  }
  .rag-heading > p {
    margin: 0 0 0.3rem;
    color: #9aa0a6;
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
  }

  .rag-shell {
    --rag-angle: 0deg;
    position: relative;
    border: 1px solid transparent;
    background:
      linear-gradient(#0b1018, #0b1018) padding-box,
      conic-gradient(
          from var(--rag-angle),
          var(--accent),
          #ffd93c,
          #ff9a3c,
          #ff5c8a,
          #b07cff,
          #7fd4ff,
          var(--accent)
        )
        border-box;
    box-shadow:
      0 0 60px rgba(var(--accent-rgb), 0.12),
      0 28px 80px rgba(0, 0, 0, 0.48);
    animation: rag-aura-spin 7s linear infinite;
  }

  .rag-chrome {
    min-height: 62px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--accent) 26%, #0d1a22);
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.28);
  }
  .rag-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .rag-title .brain {
    font-size: 1.25rem;
    filter: drop-shadow(0 0 8px rgba(255, 92, 138, 0.45));
  }
  .rag-title > span:last-child {
    display: grid;
    min-width: 0;
  }
  .rag-title strong {
    color: #fff;
    font-size: 0.88rem;
  }
  .rag-title small {
    overflow: hidden;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.63rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rag-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.68rem;
    font-weight: 760;
    white-space: nowrap;
  }
  .rag-status > span {
    width: 0.46rem;
    height: 0.46rem;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #3cf26b, #ffd93c, #ff5c8a, #b07cff, #7fd4ff, #3cf26b);
    box-shadow: 0 0 12px #b07cff;
    animation: rag-status-pulse 1.4s ease-in-out infinite;
  }
  .rag-view {
    justify-self: end;
    display: flex;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.66rem;
  }
  .rag-view span,
  .rag-view strong {
    padding: 0.36rem 0.55rem;
  }
  .rag-view span {
    color: rgba(255, 255, 255, 0.55);
  }
  .rag-view strong {
    color: var(--accent);
    background: rgba(var(--accent-rgb), 0.13);
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .scenario-bar {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.015);
  }
  .scenario-bar > span {
    color: #6c7280;
    font-size: 0.62rem;
    font-weight: 820;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .scenario-buttons {
    display: flex;
    gap: 0.4rem;
  }
  .scenario-buttons button {
    min-height: 31px;
    padding: 0.35rem 0.62rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.025);
    color: #9aa0a6;
    font-size: 0.68rem;
    font-weight: 720;
  }
  .scenario-buttons button > span {
    color: #5a6270;
    margin-right: 0.25rem;
    font-size: 0.58rem;
  }
  .scenario-buttons button:hover {
    color: #fff;
    border-color: rgba(var(--accent-rgb), 0.45);
  }
  .scenario-buttons button[aria-pressed="true"] {
    color: #fff;
    border-color: var(--accent);
    background: rgba(var(--accent-rgb), 0.16);
    box-shadow:
      inset 0 -2px var(--accent),
      0 0 18px rgba(var(--accent-rgb), 0.12);
  }
  .scenario-buttons button[aria-pressed="true"] > span {
    color: var(--accent);
  }

  .rag-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 0.85fr);
    min-height: 515px;
  }
  .graph-panel,
  .pack-panel {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }
  .graph-panel {
    background:
      radial-gradient(circle at 50% 48%, rgba(var(--accent-rgb), 0.12), transparent 28%),
      linear-gradient(rgba(var(--accent-rgb), 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--accent-rgb), 0.035) 1px, transparent 1px), #07100f;
    background-size:
      auto,
      24px 24px,
      24px 24px,
      auto;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pack-panel {
    padding: 0 1rem 1rem;
    background: #090c13;
  }
  .panel-label {
    position: relative;
    z-index: 6;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 38px;
    padding: 0 0.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: #7f8792;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.11em;
  }
  .panel-label small {
    color: #4d5561;
    font-size: 0.55rem;
    letter-spacing: 0.04em;
  }

  .graph-edges {
    position: absolute;
    z-index: 1;
    inset: 38px 0 0;
    width: 100%;
    height: calc(100% - 38px);
  }
  .graph-edges line {
    stroke: rgba(127, 212, 255, 0.14);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    transition:
      stroke 240ms ease,
      stroke-width 240ms ease;
  }
  .graph-edges line.is-match {
    stroke: rgba(var(--accent-rgb), 0.76);
    stroke-width: 1.45;
    stroke-dasharray: 6 5;
    animation: rag-edge-flow 1.2s linear infinite;
    filter: drop-shadow(0 0 3px rgba(var(--accent-rgb), 0.7));
  }

  .query-node {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 48%;
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(var(--accent-rgb), 0.84);
    border-radius: 50%;
    background: rgba(6, 8, 13, 0.9);
    box-shadow:
      0 0 0 8px rgba(var(--accent-rgb), 0.05),
      0 0 30px rgba(var(--accent-rgb), 0.3);
  }
  .query-node::before {
    content: "";
    position: absolute;
    inset: -9px;
    border: 1px dashed rgba(var(--accent-rgb), 0.34);
    border-radius: 50%;
    animation: query-orbit 8s linear infinite;
  }
  .query-node span {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  .query-node small {
    margin-top: -1.3rem;
    color: #7c8490;
    font-size: 0.53rem;
  }

  .memory-node {
    position: absolute;
    z-index: 3;
    left: var(--node-x);
    top: var(--node-y);
    display: flex;
    align-items: center;
    gap: 0.32rem;
    max-width: 118px;
    transform: translate(-50%, -50%);
    color: #6f7782;
    font-size: 0.56rem;
    line-height: 1.15;
    transition:
      color 260ms ease,
      transform 260ms ease;
  }
  .memory-node i {
    width: 10px;
    height: 10px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #3a5661;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 260ms ease;
  }
  .memory-node--rule i {
    background: #a78930;
  }
  .memory-node--decision i {
    background: #93577a;
  }
  .memory-node--skill i {
    background: #348b85;
  }
  .memory-node--hub i {
    width: 15px;
    height: 15px;
    background: #aa5e8e;
  }
  .memory-node.is-match {
    z-index: 4;
    color: #fff;
    transform: translate(-50%, -50%) scale(1.08);
    animation: node-arrive 580ms both var(--node-delay);
  }
  .memory-node.is-match i {
    background: var(--accent);
    border-color: #fff;
    box-shadow:
      0 0 7px var(--accent),
      0 0 20px rgba(var(--accent-rgb), 0.72);
    animation: node-breathe 1.8s ease-in-out infinite var(--node-delay);
  }
  .memory-node--hub.is-match i {
    background: #ff5c8a;
    box-shadow:
      0 0 8px #ff5c8a,
      0 0 24px rgba(255, 92, 138, 0.68);
  }

  .graph-legend {
    position: absolute;
