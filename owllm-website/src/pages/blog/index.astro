---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";

const posts = [
  {
    title: "Welcome to the OwLLM blog",
    slug: "welcome",
    date: "2025-07-20",
    excerpt:
      "We're building a local-first AI workstation where you own the hardware, the models, and the agent runtime. Follow along for releases, deep-dives, and behind-the-scenes notes.",
  },
];
---

<Layout title="Blog" description="News, releases, and deep-dives from the OwLLM team.">
  <section class="page-header" aria-labelledby="blog-title">
    <div class="container">
      <h1 id="blog-title">Blog</h1>
      <p class="subtitle">News, releases, and deep-dives from the OwLLM team.</p>
    </div>
  </section>

  <section class="section" aria-label="Blog posts">
    <div class="container">
      <div class="posts">
        {
          posts.map((post) => (
            <Card as="article" class="post-card">
              <time datetime={post.date}>{post.date}</time>
              <h2>
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>
              <p>{post.excerpt}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    padding: 4rem 0 2rem;
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-panel) 100%);
    text-align: center;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 1.125rem;
    max-width: 60ch;
    margin: 0 auto;
  }

  .section {
    padding: 3rem 0 5rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 768px;
    margin: 0 auto;
  }

  .post-card time {
    display: block;
    color: var(--fg-subtle);
    font-size: 0.875rem;
    margin-bottom: 0.5rem;
  }

  .post-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .post-card a {
    color: var(--accent-ink);
    text-decoration: none;
  }

  .post-card a:hover {
    text-decoration: underline;
  }

  .post-card p {
    color: var(--fg-muted);
    margin: 0;
  }
</style>
