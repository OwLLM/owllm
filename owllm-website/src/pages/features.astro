---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import DifferenceShowcase from "../components/DifferenceShowcase.astro";
// Real screenshots of the shipping interface (scripts/capture-app-shots.mjs).
import appModels from "../assets/app/models.png";
import appAgents from "../assets/app/agents.png";
import appCode from "../assets/app/code.png";
import appChat from "../assets/app/chat.png";

interface FeatureGroup {
  id: string;
  emoji: string;
  title: string;
  intro: string;
  points: { title: string; body: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const groups: FeatureGroup[] = [
  {
    id: "models",
    emoji: "📦",
    title: "Models & inference",
    intro:
      "Local models are the default, cloud models are first-class peers, and nothing ever picks a model for you.",
    image: appModels,
    imageAlt: "The real OWLLM Models page with VRAM-fit color coding",
    points: [
      {
        title: "Local serving that manages itself",
        body: "llama.cpp (llama-server) starts on your first message, sizes its context window to your VRAM, and is shared across every OWLLM window and instance — one server, adopted by all.",
      },
      {
        title: "VRAM-aware model browsing",
        body: "Search all of HuggingFace or use curated recommendations. Every result is color-coded against your GPU: green fits inference + fine-tuning, amber is tight, red is search-only. Interrupted downloads resume from where they stopped via HTTP range requests.",
      },
      {
        title: "Vision without ceremony",
        body: "Vision-capable GGUF models just work — OWLLM auto-downloads the matching image projector (--mmproj) and wires it in.",
      },
      {
        title: "Cloud models as peers",
        body: "Anthropic, OpenAI, Gemini and Kimi via API keys, or subscription CLIs (Claude Code, Codex, Gemini, Kimi) — all in the same model picker as your local models, everywhere in the app.",
      },
      {
        title: "No auto-picked models, ever",
        body: "Until you explicitly choose, every picker reads “Select model” and Send/Generate/Run stays blocked. A run can never silently use — or bill — weights you never chose.",
      },
      {
        title: "Native GGUF tool-calling",
        body: "Tools go to the model as a native OpenAI tools array rendered through the model's own chat template, and come back as structured tool_calls. No XML protocols, no prompt hacks.",
      },
    ],
  },
  {
    id: "agents",
    emoji: "🤖",
    title: "Agentic teams",
    intro:
      "A visible, steerable workforce with verification, memory, project rules, and a Critical Thinker that can make routine decisions for you.",
    image: appAgents,
    imageAlt: "The real OWLLM Agents page — the agentic creation launchpad",
    points: [
      {
        title: "One standard team, many profiles",
        body: "Every template — Dev Squad, Chief of Staff, Research — is a profile over the same roster: an orchestrator that plans, a read-only scout, two parallel workers, an advisory critic, and a producer that only delivers review-approved work. Solo-Loop collapses to one coder with critic and producer.",
      },
      {
        title: "Workflow ↔ Solo-Loop · Graph ↔ Chat",
        body: "The Agentic header switches the execution shape and the visual perspective independently. Use the editable graph to inspect routing, then replace it with one live transcript per agent without interrupting the run or flattening the team into one synthetic chat.",
      },
      {
        title: "Project environments that arrange themselves",
        body: "Project kinds persist a workspace recipe, not only a team name. Web and research work open the shared browser beside OWLLM; responsive work uses a phone viewport; assistants open the exact mail, messaging, calendar, document, social, and custom sites you choose.",
      },
      {
        title: "The Verification Gate",
        body: "“Done” is never the model's opinion. A real command — your test suite, your build — must exit 0 before work counts as finished, with per-agent verify-fix loops.",
      },
      {
        title: "Mid-run steering",
        body: "Type while a run is going and your message queues as a ⚡ steer, injected at the next agent boundary — or between tool calls on local models. Never dropped.",
      },
      {
        title: "A live psychedelic activity signal",
        body: "While work is running, the active chat, agent card, page tab, and module button use the same rotating rainbow aura. Switch pages freely: OWLLM still shows exactly where work is active and marks finished pages you have not reopened yet.",
      },
      {
        title: "Memory that stays useful",
        body: "Per-agent episodic history plus shared project memory: durable facts and auto-captured worklog are retrieved by scoped BM25-style relevance and prepended as a fenced MEMORY CURATOR CONTEXT PACK. A post-run curator saves at most two novel facts, so memory never becomes a transcript dump.",
      },
      {
        title: "Skills Library + Auto Skills + default rules",
        body: "Install and preview compatible SKILL.md packs from curated or custom Git sources, then equip them per role. Every project is seeded with production-minded must / prefer / avoid rules, while the goal automatically selects up to two additional relevant installed skills before the first token.",
      },
      {
        title: "Run Notebook",
        body: "A per-project scratchpad, plan, and NEXT-STEPS queue with a 🪄 digest agent that turns raw notes into implementable cards. Auto-feed advances only after a clean run, so a healthy queue can keep the project moving for hours without becoming an unbounded loop.",
      },
      {
        title: "Brainstorm + Director mode",
        body: "Brainstorm develops an idea through co-founder-style conversation, research, and a reusable brief before the build starts. When “critic = super user” is enabled, the Critical Thinker can make routine decisions in your place while every project rule remains in force.",
      },
    ],
  },
  {
    id: "coding",
    emoji: "💻",
    title: "Coding",
    intro:
      "A persistent private workspace with two independent agents, selectable feedback loops, usage visibility, and three levels of autonomy.",
    image: appCode,
    imageAlt: "The real OWLLM Coding page — private AI workspace launchpad",
    points: [
      {
        title: "Projects that come back",
        body: "Each Coding page is its own chat, plan board, and private git worktree on its own branch — close OWLLM and everything returns when you reopen the project. Merge back from the header when ready.",
      },
      {
        title: "Two agents that can review each other",
        body: "Open a second coding agent beside the first. It has its own model picker, transcript, composer, tools, and stop control. Feed the first reply to the second for review, send the second response back to the first, or enable both directions for a bounded six-exchange feedback loop.",
      },
      {
        title: "Different models, different opinions",
        body: "The second agent can inherit the first model or use a completely different local, API, or subscription model. That makes review a real second perspective instead of another pass through identical weights and context.",
      },
      {
        title: "Plan / Auto / Chat",
        body: "Plan breaks a goal into ordered Kanban work and executes it step by step. Auto reads, edits, creates, and runs directly. Chat is deliberately read-only for discussion and review. Watch live diffs, open and edit files, use the terminal, or paste images and documents.",
      },
      {
        title: "Super User column",
        body: "Project rules and the Notebook sit beside the chat and are shared with Agentic Team when the folder belongs to the same project. The panel also shows provider quota windows, balances when exposed, and OWLLM-recorded turns and estimated tokens for every model route.",
      },
      {
        title: "Project Memory in both panes",
        body: "Before either coding agent starts, it retrieves relevant project facts and worklogs and shows the memory_context card in that agent's transcript. Both agents write their completed work back to the same project scope.",
      },
    ],
  },
  {
    id: "safety",
    emoji: "🛡️",
    title: "Isolation & safety",
    intro:
      "Autonomous agents that edit files and run commands are powerful and risky — so the dangerous parts run in a real sandbox.",
    points: [
      {
        title: "OS-level Linux sandbox",
        body: "Tool execution runs inside bubblewrap in WSL2 on Windows, Lima on macOS, and bwrap on Linux. Agents see only the project folder — the real folder, no copy. Cloud CLIs run inside too, with logins mirrored in automatically.",
      },
      {
        title: "Graduated trust",
        body: "Sandbox is the default; full host access is a deliberate per-project opt-out, never a silent upgrade.",
      },
      {
        title: "Split across machines",
        body: "The model server and the agents don't have to share a machine: run llama-server where your GPU is and let agents call it over an OpenAI-compatible HTTP API from a Linux box or sandbox.",
      },
      {
        title: "Zero embedded secrets",
        body: "Installers and releases ship with no credentials. API keys and logins live only in your local, encrypted vault.",
      },
    ],
  },
  {
    id: "finetuning",
    emoji: "🎯",
    title: "Fine-tuning & model surgery",
    intro:
      "From documents to a custom model, on your own GPU.",
    image: appChat,
    imageAlt: "The real OWLLM Chat page — test your models where you tuned them",
    points: [
      {
        title: "Dataset Builder",
        body: "Turn PDFs, DOCX files, and web pages into instruction/output training pairs, review them, and export — no notebook required.",
      },
      {
        title: "LoRA training with a live loss curve",
        body: "The Python training environment installs itself on demand (it's only needed for Train). Watch the loss curve live, then export to GGUF — your custom model appears in the same picker as everything else.",
      },
      {
        title: "Chat, right there",
        body: "The Chat tab shares the same model picker and server, so the loop is Models → Dataset → Train → Chat, left to right.",
      },
    ],
  },
  {
    id: "connect",
    emoji: "🌐",
    title: "Bridges, devices & MCP",
    intro:
      "Drive your workstation from anywhere, extend it with tools, and pair your other machines.",
    points: [
      {
        title: "Messaging bridges",
        body: "Text your own computer from WhatsApp or Telegram and the message becomes an agent-team run, with results streaming back into the chat.",
      },
      {
        title: "Remote devices, no SSH",
        body: "Pair your machines over an end-to-end encrypted channel (Ed25519-signed, X25519-sealed). Run permitted commands, see screens, install software, or select and start a local model on your gaming PC directly from the laptop's model picker.",
      },
      {
        title: "MCP with a safety gate",
        body: "MCP servers auto-start with a master switch, per-tool toggles, and a schema-safety gate — agents get exactly the tools you approve, no more.",
      },
      {
        title: "In-app agent browser",
        body: "A real visible browser agents can drive with stable tabs: open and navigate, snapshot interactive elements, read, click, fill, select, scroll histories, press keys, upload files, switch mobile device profiles, and capture screenshots. Use it for email, messengers, social sites, SaaS applications, local web apps, and forms across languages, with role-gated consequential actions.",
      },
    ],
  },
  {
    id: "platform",
    emoji: "⚙️",
    title: "Personalization, platform & updates",
    intro:
      "An operator-grade workspace should adapt to your eyes, your language, your hardware, and your operating system.",
    points: [
      {
        title: "Dark/light skins + independent colors",
        body: "Switch dark or light mode, choose the GUI accent, and choose the text color independently. OWLLM contrast-corrects text against every themed surface instead of letting a custom palette make the interface unreadable.",
      },
      {
        title: "10–22 px chat text zoom",
        body: "Persist the text size from Settings or hold Ctrl and use the mouse wheel directly over chat, Notebook, Brainstorm, Code, or agent inputs. The rest of the interface stays at the same scale.",
      },
      {
        title: "Eight interface languages",
        body: "The application interface includes English, Chinese, Korean, Japanese, Arabic, Italian, Hindi, and Portuguese localization, while browser and agent workflows can reason over whatever languages the selected model supports.",
      },
      {
        title: "Windows, Linux, macOS — and ARM",
        body: "Per-platform engine variants: CUDA/Vulkan/CPU on Windows x64, Vulkan/CPU on Linux x64, CUDA on Jetson-class Linux ARM64, Metal on Apple Silicon (one universal bundle). Unsupported combos degrade honestly instead of offering a foreign binary.",
      },
      {
        title: "Signed auto-updates",
        body: "Updates ship with a branded, plain-language changelog over a signed installer path, so you always know what changed and that it came from us.",
      },
      {
        title: "Marketplace",
        body: "Community team profiles, skill packs, and MCP connector packs install straight into the app. Browse without an account; only reviewed listings are published.",
      },
    ],
  },
];
---

<Layout
  title="Features"
  description="Explore OWLLM's Orchestrated Workflow, Solo-Loop, agent Graph and Chat views, Skills Library, adaptive project environments, Memory Curator RAG, browser automation, P2P devices, coding loops, and local models."
>
  <section class="page-header" aria-labelledby="features-title">
    <div class="container">
      <p class="eyebrow">Orchestrated Workflow for Large Language Models</p>
      <h1 id="features-title">The complete OWLLM workstation.</h1>
      <p class="subtitle">
        Code with a second opinion. Run a team. Let memory bring back the right decisions. Queue
        hours of verified work. Operate the browser and the rest of your compute fleet—all from one app.
      </p>
      <nav class="group-nav" aria-label="Feature groups">
        {groups.map((g) => <a href={`#${g.id}`}>{g.emoji} {g.title}</a>)}
      </nav>
    </div>
  </section>

  <DifferenceShowcase />

  <section class="section" aria-label="Feature groups">
    <div class="container">
      {
        groups.map((group, index) => (
          <article class="group" id={group.id}>
            <header class="group-head">
              <span class="group-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h2>
                  <span aria-hidden="true">{group.emoji}</span> {group.title}
                </h2>
                <p class="group-intro">{group.intro}</p>
              </div>
            </header>
            {group.image && (
              <Image
                src={group.image}
                alt={group.imageAlt || ""}
                widths={[640, 1024, 1440]}
                sizes="(max-width: 900px) 100vw, 900px"
                loading="lazy"
                decoding="async"
                class="group-shot"
              />
            )}
            <div class="point-grid">
              {group.points.map((point) => (
                <div class="point">
                  <h3>{point.title}</h3>
                  <p>{point.body}</p>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section cta" aria-label="Try it">
    <div class="container cta-inner">
      <h2>See it before you install it</h2>
      <p class="cta-lead">
        The How-to-use guide embeds the real interface, clickable, in your browser.
      </p>
      <div class="cta-buttons">
        <Button href="/how-to-use" size="lg">▶ Try the real app in your browser</Button>
        <Button href="/download" variant="outline" size="lg">⬇ Download OwLLM</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    padding: 5rem 0 2.75rem;
    background:
      radial-gradient(circle at 50% 0%, rgba(var(--accent-rgb), 0.22), transparent 50%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg-panel) 100%);
    text-align: center;
  }

  .page-header h1 {
    max-width: 920px;
    margin-inline: auto;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
    margin-bottom: 0.75rem;
  }

  .eyebrow {
    margin-bottom: 0.7rem;
    color: var(--accent-ink);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 1.125rem;
    max-width: 70ch;
    margin: 0 auto;
  }

  .group-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .group-nav a {
    border: 1px solid var(--border-strong);
    background: var(--ghost-bg);
    color: var(--ghost-fg);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .group-nav a:hover {
    background: var(--ghost-hover-bg);
    color: var(--ghost-hover-fg);
  }

  .section {
    padding: 3rem 0 4rem;
  }

  .group {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 5rem;
  }

  .group:last-of-type {
    border-bottom: none;
  }

  .group-head {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .group-num {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--accent);
    opacity: 0.6;
    line-height: 1;
  }

  .group-head h2 {
    font-size: 1.6rem;
    margin: 0 0 0.35rem;
  }

  .group-intro {
    color: var(--fg-muted);
    margin: 0;
    max-width: 70ch;
  }

  .group-shot {
    width: 100%;
    height: auto;
    box-shadow: var(--shadow-lg);
    margin-bottom: 1.5rem;
  }

  .point-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 1rem;
  }

  .point {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
  }

  .point h3 {
    font-size: 1.02rem;
    margin: 0 0 0.4rem;
  }

  .point p {
    color: var(--fg-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .cta {
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    margin-bottom: 0.5rem;
  }

  .cta-lead {
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
