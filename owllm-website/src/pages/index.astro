---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import DifferenceShowcase from "../components/DifferenceShowcase.astro";
// Real screenshots of the actual app UI, captured by
// scripts/capture-app-shots.mjs — never stock imagery.
import appHome from "../assets/app/home.png";
import appModels from "../assets/app/models.png";
import appChat from "../assets/app/chat.png";
import appAgents from "../assets/app/agents.png";
import appCode from "../assets/app/code.png";
import orchestratedWorkflow from "../assets/app/orchestrated-workflow.png";

// Every image below is a real screenshot of the shipping interface,
// captured from the browser build by scripts/capture-app-shots.mjs.
const demos = [
  {
    title: "One launchpad for everything",
    description:
      "The Home screen probes your GPU, VRAM, and software setup on startup, then puts every module one click away: local models and fine-tuning, the agentic team, and the experimental Gamify world. What your machine can run is visible before you commit to anything.",
    image: appHome,
    alt: "The real OWLLM Home page: module cards, System Status hardware probe, and Software Requirements checklist",
  },
  {
    title: "Agent teams with isolated workspaces",
    description:
      "Describe the outcome you want in plain language and a standard six-slot team goes to work — orchestrator, scout, two parallel workers, critic, and producer. Each specialist works in its own git worktree on a dedicated branch, then merges back with conflict detection.",
    image: appAgents,
    alt: "The real OWLLM Agents page: the agentic creation launchpad where you describe a goal and prepare a project",
  },
  {
    title: "Every model, sized against your GPU",
    description:
      "Search all of HuggingFace or pick from curated recommendations — every result is color-coded against your actual VRAM: green fits, amber is tight, red is search-only. Interrupted downloads resume where they stopped, and fine-tuned artifacts get their own Tuned tab.",
    image: appModels,
    alt: "The real OWLLM Models page: HuggingFace browser with VRAM-fit color coding and filter chips",
  },
  {
    title: "Code page with project persistence",
    description:
      "Open any folder as a project and the model keeps coding across sessions — conversation, plan, and chosen model come back when you reopen it. Tool execution runs inside a real Linux sandbox, so your host files stay untouched.",
    image: appCode,
    alt: "The real OWLLM Coding page: the private AI workspace launchpad with Build with Code, Just chat, and Agent team options",
  },
];

const comparisons = [
  {
    aspect: "Parallel and background work",
    owllm: "A visible role graph, one live transcript per agent, two isolated Worker lanes, persistent pages, and mid-run steering.",
  },
  {
    aspect: "Skills and custom instructions",
    owllm: "A real Skills Library, per-role equipment, automatic 1–2 skill selection, and default project rules shared across every model path.",
  },
  {
    aspect: "Persistent memory",
    owllm: "Durable facts and capped worklogs, scoped retrieval, a fenced context pack, a bounded Curator, vault sync, and a 3D graph view.",
  },
  {
    aspect: "Browser and app preview",
    owllm: "Project recipes open the shared agent browser beside OWLLM, choose desktop or mobile viewports, and preserve authenticated tabs locally.",
  },
  {
    aspect: "Long-running autonomy",
    owllm: "Notebook auto-feed advances one implementable card at a time only after a clean run; stopped and failed work pauses the queue.",
  },
  {
    aspect: "Model and machine freedom",
    owllm: "Assign local GGUF, API, or subscription-CLI models per role, then reach encrypted peer devices and their local models without SSH.",
  },
];

const socialProof = [
  { label: "Agentic modes", value: "Workflow ↔ Solo-Loop" },
  { label: "Team visibility", value: "Graph ↔ live Chat" },
  { label: "Model routing", value: "Per role · any provider" },
  { label: "Completion", value: "Verification Gate" },
];
---

<Layout
  title="OWLLM — Orchestrated Workflow for Large Language Models"
  description="A local-first AI workstation for visible agent teams, Solo-Loops, mixed-model orchestration, project memory, skills, browser automation, and verified long-running work."
>
  <section class="hero" aria-labelledby="hero-heading">
    {/* App-native backdrop: the same light-grid + aurora-orb treatment the
        app draws on its creation launchpads (owllm-desktop styles.css),
        rebuilt here in CSS — no stock photography anywhere on this site. */}
    <div class="hero-background" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="hero-orb hero-orb--one"></div>
      <div class="hero-orb hero-orb--two"></div>
    </div>
    <div class="hero-content container">
      <div class="hero-text">
        <div class="hero-badge"><span aria-hidden="true"></span> Orchestrated Workflow for Large Language Models</div>
        <h1 id="hero-heading">
          Orchestrate the work. <span class="accent-text">Not just the prompt.</span>
        </h1>
        <p class="hero-tagline">
          Watch a visible team plan, scout, execute in parallel, review, and publish—or collapse it
          to a lean Solo-Loop. Give every role the model, skills, memory, tools, browser, and project
          rules it needs, then let real verification decide when the work is done.
        </p>
        <div class="hero-actions">
          <Button href="/download" size="lg">Download OwLLM</Button>
          <Button href="/how-to-use" variant="outline" size="lg">Try the real app</Button>
        </div>
        <div class="hero-social-proof" aria-label="Key highlights">
          {
            socialProof.map((item) => (
              <div class="proof-pill">
                <span class="proof-value">{item.value}</span>
                <span class="proof-label">{item.label}</span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="hero-media">
        <figure class="hero-app">
          <Image
            src={orchestratedWorkflow}
            alt="The real OWLLM Orchestrated Workflow graph"
            widths={[640, 960, 1440]}
            sizes="(max-width: 900px) 100vw, 52vw"
            loading="eager"
            decoding="async"
            priority
            class="hero-image"
          />
          <figcaption><span aria-hidden="true"></span> Real app · Orchestrated Workflow view</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <DifferenceShowcase />

  <section class="section demos-section" aria-labelledby="demos-heading">
    <div class="container">
      <h2 id="demos-heading" class="section-title">See it in action</h2>
      <p class="section-subtitle">
        Concrete architecture choices that make OwLLM a workstation, not just a chat window.
      </p>
      <div class="demo-list">
        {
          demos.map((demo, index) => (
            <article class={`demo-row ${index % 2 === 1 ? "reversed" : ""}`}>
              <div class="demo-media">
                <Image
                  src={demo.image}
                  alt={demo.alt}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  loading="lazy"
                  decoding="async"
                  class="demo-image"
                />
              </div>
              <div class="demo-text">
                <h3>{demo.title}</h3>
                <p>{demo.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section explore-section" aria-labelledby="explore-heading">
    <div class="container">
      <h2 id="explore-heading" class="section-title">Explore before you install</h2>
      <div class="explore-grid">
        <article class="explore-card">
          <span class="explore-emoji" aria-hidden="true">🖱️</span>
          <h3>Click through the real app — right in your browser</h3>
          <p>
            The How-to-use guide embeds the actual OwLLM interface — the same React application
            that ships in the desktop app, running in your browser. Every module, every tab, every
            dialog, plus a step-by-step guide from install to your first agent team.
          </p>
          <Button href="/how-to-use" variant="outline">▶ Take the interactive tour</Button>
        </article>
        <article class="explore-card">
          <span class="explore-emoji" aria-hidden="true">🛒</span>
          <h3>Shop the Marketplace</h3>
          <p>
            Community-built team profiles, skill packs, MCP connector packs, and project templates
            that install straight into the app. Browse the catalog without an account.
          </p>
          <Button href="/marketplace" variant="outline">Browse the Marketplace</Button>
        </article>
      </div>
    </div>
  </section>

  <section class="section comparison-section" aria-labelledby="comparison-heading">
    <div class="container">
      <h2 id="comparison-heading" class="section-title">What the category asks for—inside one system</h2>
      <p class="section-subtitle">
        Current agent products are converging on background work, memory, rules, skills, custom
        agents, and browsers. OWLLM connects those expectations to one visible, local-first runtime.
      </p>
      <div
        class="comparison-table-wrapper"
        role="region"
        aria-label="Capability comparison"
        tabindex="0"
      >
        <table class="comparison-table">
          <caption class="sr-only">
            Current agent-product expectations and OWLLM's implementation
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">How OWLLM implements it</th>
            </tr>
          </thead>
          <tbody>
            {
              comparisons.map((row) => (
                <tr>
                  <th scope="row">{row.aspect}</th>
                  <td>{row.owllm}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="comparison-note">
        OWLLM does not reject the cloud. Claude, GPT, Gemini, Kimi, DeepSeek, Groq, and subscription
        CLIs can work beside local models; you decide the model per role and where each workload runs.
      </p>
      <p class="comparison-sources">
        Competitive signal—not a popularity ranking: current official product documentation repeatedly
        invests in <a href="https://docs.cursor.com/background-agent" target="_blank" rel="noreferrer">background agents</a>,
        <a href="https://docs.github.com/en/copilot/concepts/agents/about-agent-skills" target="_blank" rel="noreferrer">skills</a>,
        <a href="https://docs.github.com/en/enterprise-cloud@latest/copilot/concepts/agents/copilot-memory" target="_blank" rel="noreferrer">memory</a>,
        <a href="https://code.claude.com/docs/en/sub-agents" target="_blank" rel="noreferrer">subagents</a>,
        <a href="https://docs.devin.ai/work-with-devin/devin-session-tools" target="_blank" rel="noreferrer">browser tools</a>, and
        <a href="https://docs.replit.com/core-concepts/agent/task-system" target="_blank" rel="noreferrer">parallel task boards</a>.
      </p>
    </div>
  </section>

  <section class="section privacy-section" aria-labelledby="privacy-heading">
    <div class="container privacy-content">
      <div class="privacy-text">
        <h2 id="privacy-heading">Your data stays yours</h2>
        <p>
          OwLLM defaults to local execution. Models run on your hardware, memory lives in your
          SQLite database, and tool execution happens inside a Linux sandbox on your machine. Cloud
          peers are available when you choose them — never as a hidden default.
        </p>
        <Button href="/download" size="lg">Get OwLLM</Button>
      </div>
      <div class="privacy-media">
        <Image
          src={appChat}
          alt="The real OWLLM Chat page — conversations run against your own model server and never leave your machine"
          widths={[400, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="lazy"
          decoding="async"
          class="privacy-image"
        />
      </div>
    </div>
  </section>

  <section class="section cta-section" aria-labelledby="cta-heading">
    <div class="container cta-content">
      <h2 id="cta-heading">Ready to run your own AI workstation?</h2>
      <p>
        Download the latest installer, pick a model, and start building agentic teams in minutes.
      </p>
      <div class="cta-actions">
        <Button href="/download" size="lg">Download OwLLM</Button>
        <Button href="/docs" variant="outline" size="lg">Read the docs</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 5rem 0;
    min-height: min(90vh, 700px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Same visual grammar as the app's creation launchpads: accent-tinted
     light grid fading downward, plus two blurred aurora orbs. */
  .hero-background {
    background:
      radial-gradient(circle at 50% -14%, rgba(var(--accent-rgb), 0.32), transparent 47%),
      linear-gradient(145deg, color-mix(in srgb, var(--bg-panel) 82%, var(--accent) 18%), var(--bg) 72%);
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    background-image:
      linear-gradient(rgba(var(--accent-rgb), 0.23) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--accent-rgb), 0.23) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.8), transparent 82%);
  }

  .hero-orb {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.28;
  }

  .hero-orb--one {
    top: -260px;
    left: -100px;
    background: var(--accent);
  }

  .hero-orb--two {
    right: -220px;
    bottom: -270px;
    background: color-mix(in srgb, var(--accent) 50%, #9878ff);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 999px;
    background-color: var(--accent-soft);
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    width: fit-content;
  }

  .hero-badge > span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #3cf26b, #ffd93c, #ff5c8a, #b07cff, #7fd4ff, #3cf26b);
    box-shadow: 0 0 12px rgba(176, 124, 255, 0.7);
    animation: hero-signal 2.6s linear infinite;
  }

  @keyframes hero-signal {
    to { transform: rotate(360deg); }
  }

  .hero-text h1 {
    font-size: clamp(2.5rem, 5.8vw, 4.85rem);
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin-bottom: 1.25rem;
  }

  .accent-text {
    color: var(--accent-ink);
  }

  .hero-tagline {
    font-size: clamp(1.03rem, 1.7vw, 1.2rem);
    color: var(--fg-muted);
    margin-bottom: 1.75rem;
    max-width: 55ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .hero-social-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .proof-pill {
    display: flex;
    flex-direction: column;
    padding: 0.625rem 1rem;
    border-radius: 8px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border);
    min-width: 120px;
  }

  .proof-value {
    font-weight: 700;
    color: var(--accent-ink);
    font-size: 0.86rem;
  }

  .proof-label {
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .hero-app {
    width: min(100%, 650px);
    margin: 0;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .hero-app figcaption {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.65rem;
    color: var(--fg-subtle);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-app figcaption span {
    width: 0.5rem;
    height: 0.5rem;
    background: conic-gradient(from 0deg, #3cf26b, #ffd93c, #ff5c8a, #b07cff, #7fd4ff, #3cf26b);
    box-shadow: 0 0 12px rgba(176, 124, 255, 0.72);
    animation: hero-signal 2.6s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-badge > span,
    .hero-app figcaption span { animation: none; }
  }

  /* Sections */
  .section {
    padding: 5rem 0;
  }

  .section-title {
    text-align: center;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    text-align: center;
    color: var(--fg-muted);
    font-size: 1.125rem;
    max-width: 65ch;
    margin: 0 auto 2.5rem;
  }

  /* Demos */
  .demos-section {
    background-color: var(--bg);
  }

  .demo-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .demo-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .demo-row.reversed .demo-media {
    order: 2;
  }

  .demo-row.reversed .demo-text {
    order: 1;
  }

  .demo-media {
    display: flex;
    justify-content: center;
  }

  .demo-image {
    box-shadow: var(--shadow-md);
    width: 100%;
    max-width: 560px;
    height: auto;
    object-fit: cover;
  }

  .demo-text h3 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--fg-strong);
  }

  .demo-text p {
    color: var(--fg-muted);
    margin: 0;
  }

  /* Comparison */
  .comparison-section {
    background-color: var(--bg-panel);
  }

  .comparison-table-wrapper {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  .comparison-table thead {
    background-color: var(--bg-elevated);
  }

  .comparison-table th,
  .comparison-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .comparison-table th {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .comparison-table thead th {
    font-weight: 700;
  }

  .comparison-table tbody tr:last-child th,
  .comparison-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comparison-table tbody tr:hover {
    background-color: var(--bg-surface);
  }

  .comparison-note {
    text-align: center;
    color: var(--fg-muted);
    max-width: 75ch;
    margin: 0 auto;
    font-size: 0.95rem;
  }

  .comparison-sources {
    max-width: 88ch;
    margin: 1rem auto 0;
    color: var(--fg-subtle);
    font-size: 0.78rem;
    text-align: center;
  }

  .comparison-sources a {
    color: var(--accent-ink);
  }

  /* Privacy */
  .privacy-section {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-panel) 100%);
  }

  .privacy-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .privacy-text h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .privacy-text p {
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    max-width: 55ch;
  }

  .privacy-media {
    display: flex;
    justify-content: center;
  }

  .privacy-image {
    border-radius: 20px;
    box-shadow: var(--shadow-md);
    width: 100%;
    max-width: 560px;
    height: auto;
    object-fit: cover;
  }

  /* CTA */
  .cta-section {
    background-color: var(--bg-panel);
    text-align: center;
  }

  .cta-content {
    max-width: 64ch;
  }

  .cta-content h2 {
    margin-bottom: 0.75rem;
  }

  .cta-content p {
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .hero-content,
    .privacy-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-actions,
    .hero-social-proof {
      justify-content: center;
    }

    .hero-app { margin-top: 1.5rem; }

    .demo-row,
    .demo-row.reversed {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .demo-row.reversed .demo-media,
    .demo-row.reversed .demo-text {
      order: unset;
    }

    .demo-text {
      text-align: center;
    }

    .privacy-text {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .explore-section {
    background: var(--bg-panel);
    border-block: 1px solid var(--border);
  }

  .explore-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .explore-card {
    background: var(--bg-card);
    border: 1px solid var(--border-accent);
    border-radius: 16px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .explore-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px var(--accent-glow-soft);
  }

  .explore-emoji {
    font-size: 2rem;
  }

  .explore-card h3 {
    font-size: 1.25rem;
    margin: 0;
  }

  .explore-card p {
    color: var(--fg-muted);
    margin: 0 0 0.5rem;
  }

  @media (max-width: 768px) {
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding: 4rem 0;
    }

    .comparison-table th,
    .comparison-table td {
      padding: 0.875rem;
      font-size: 0.9rem;
    }

    .demo-image,
    .privacy-image {
      max-height: 300px;
    }
  }
</style>
