---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";

interface Scenario {
  id: string;
  title: string;
  domain: string;
  goal: string;
  setup: string[];
  workflow: string[];
  autonomy: { autonomous: string[]; humanApproved: string[] };
  safeguards: string[];
  outcomes: string[];
}

import useCases from "../data/use-cases.json";

const scenarios: Scenario[] = useCases.scenarios;

const site = Astro.site?.toString().replace(/\/$/, "") || "https://owllm.com";
const canonical = new URL("/use-cases/", site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "OwLLM Use Cases",
  description:
    "Ten practical OwLLM scenarios across security, operations, reporting, marketing, daily assistance, research, messaging, email, CRM, and multi-agent software delivery.",
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: scenarios.map((scenario, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: scenario.title,
      url: `${canonical}#${scenario.id}`,
    })),
  },
};
---

<Layout
  title="Use cases"
  description="Explore ten practical OwLLM scenarios: security analysis, incident response, management reporting, marketing, daily assistance, browser research, WhatsApp, email, CRM, and multi-agent software delivery."
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <section class="page-header" aria-labelledby="use-cases-title">
    <div class="container">
      <h1 id="use-cases-title">Use cases</h1>
      <p class="subtitle">
        Realistic scenarios for OwLLM. Every workflow clearly separates what the agent can do on its
        own from what waits for your approval.
      </p>
    </div>
  </section>

  <nav class="toc-section" aria-labelledby="toc-title">
    <div class="container">
      <h2 id="toc-title" class="toc-heading">On this page</h2>
      <ol class="toc-list">
        {
          scenarios.map((scenario) => (
            <li>
              <a href={`#${scenario.id}`}>{scenario.title}</a>
            </li>
          ))
        }
      </ol>
    </div>
  </nav>

  <section class="boundary-notice" aria-labelledby="boundary-title">
    <div class="container">
      <div class="notice-card">
        <h2 id="boundary-title" class="notice-title">Automation boundaries</h2>
        <p>
          OwLLM runs tools inside a sandboxed Linux environment. Steps marked
          <span class="badge badge-autonomous">Autonomous</span> can execute automatically once you grant
          the relevant tool permission. Steps marked
          <span class="badge badge-human">Human-approved</span> always pause for your explicit confirmation
          before they run.
        </p>
        <p class="notice-sub">
          OWLLM does not come with built-in access to your email, WhatsApp, CRM, cloud accounts, or
          social platforms. Any integration uses credentials or bridges you supply and configure
          locally.
        </p>
      </div>
    </div>
  </section>

  <section class="scenarios-section" aria-label="Use case scenarios">
    <div class="container">
      <div class="scenario-list">
        {
          scenarios.map((scenario) => (
            <Card as="article" class="scenario-card" id={scenario.id}>
              <header class="scenario-header">
                <span class="scenario-domain">{scenario.domain}</span>
                <h2 class="scenario-title">{scenario.title}</h2>
                <p class="scenario-goal">{scenario.goal}</p>
              </header>

              <div class="scenario-body">
                <section aria-labelledby={`${scenario.id}-setup`}>
                  <h3 id={`${scenario.id}-setup`}>Setup & access</h3>
                  <ul>
                    {scenario.setup.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>

                <section aria-labelledby={`${scenario.id}-workflow`}>
                  <h3 id={`${scenario.id}-workflow`}>Workflow</h3>
                  <ol>
                    {scenario.workflow.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                </section>

                <section aria-labelledby={`${scenario.id}-autonomy`}>
                  <h3 id={`${scenario.id}-autonomy`}>Automation boundary</h3>
                  <div class="autonomy-grid">
                    <div>
                      <h4 class="autonomy-heading autonomy-heading-autonomous">Autonomous</h4>
                      <ul>
                        {scenario.autonomy.autonomous.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <h4 class="autonomy-heading autonomy-heading-human">Human-approved</h4>
                      <ul>
                        {scenario.autonomy.humanApproved.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </section>

                <section aria-labelledby={`${scenario.id}-safeguards`}>
                  <h3 id={`${scenario.id}-safeguards`}>Safeguards</h3>
                  <ul>
                    {scenario.safeguards.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>

                <section aria-labelledby={`${scenario.id}-outcomes`}>
                  <h3 id={`${scenario.id}-outcomes`}>Measurable outcomes</h3>
                  <ul>
                    {scenario.outcomes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </section>
              </div>
            </Card>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .page-header {
    padding: 4rem 0 2rem;
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-panel) 100%);
    text-align: center;
  }

  .page-header h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 1.125rem;
    max-width: 60ch;
    margin: 0 auto;
  }

  .toc-section {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .toc-heading {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    color: var(--fg-strong);
  }

  .toc-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .toc-list li {
    display: flex;
  }

  .toc-list a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    background-color: var(--bg-surface);
    color: var(--fg);
    text-decoration: none;
    font-size: 0.9375rem;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .toc-list a:hover,
  .toc-list a:focus-visible {
    background-color: var(--bg-surface-hover);
    color: var(--fg-strong);
  }

  .boundary-notice {
    padding: 2rem 0;
  }

  .notice-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .notice-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .notice-card p {
    color: var(--fg-muted);
    margin-bottom: 0.75rem;
  }

  .notice-sub {
    font-size: 0.9375rem;
    color: var(--fg-subtle);
    margin-bottom: 0;
  }

  .badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .badge-autonomous {
    background-color: var(--ok);
    color: #ffffff;
  }

  .badge-human {
    background-color: var(--accent);
    color: var(--accent-fg);
  }

  .scenarios-section {
    padding: 2rem 0 5rem;
  }

  .scenario-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .scenario-card {
    scroll-margin-top: 6rem;
  }

  .scenario-header {
    margin-bottom: 1.25rem;
  }

  .scenario-domain {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    margin-bottom: 0.5rem;
  }

  .scenario-title {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    margin-bottom: 0.75rem;
  }

  .scenario-goal {
    color: var(--fg-muted);
    margin: 0;
    font-size: 1.0625rem;
  }

  .scenario-body {
    display: grid;
    gap: 1.25rem;
  }

  .scenario-body section h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.5rem;
    color: var(--fg-strong);
  }

  .scenario-body ul,
  .scenario-body ol {
    padding-left: 1.25rem;
    color: var(--fg-muted);
  }

  .scenario-body li {
    margin-bottom: 0.375rem;
  }

  .autonomy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .autonomy-heading {
    font-size: 0.9375rem;
    margin-bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .autonomy-heading-autonomous::before {
    content: "";
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--ok);
  }

  .autonomy-heading-human::before {
    content: "";
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background-color: var(--accent);
  }

  @media (max-width: 640px) {
    .toc-list {
      grid-template-columns: 1fr;
    }

    .autonomy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
